.gate-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.06);
}
.gate-in {
  display: flex;
  align-items: center;
}
.gate-input {
  flex: 1;
  height: 84rpx;
  background: #f8fafc;
  border: 1rpx solid #e8ecf1;
  border-radius: 16rpx;
  padding: 0 22rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-sizing: border-box;
}
.gate-btn {
  margin-left: 16rpx;
  width: 150rpx;
  height: 84rpx;
  flex: 0 0 auto;
}
.gate-res {
  margin-top: 20rpx;
  border-radius: 16rpx;
  padding: 22rpx;
  text-align: center;
}
.gate-res.ok { background: #dcfce7; border: 1rpx solid #86efac; }
.gate-res.no { background: #fee2e2; border: 1rpx solid #fca5a5; }
.gate-res-title { font-size: 30rpx; font-weight: 800; }
.gate-res.ok .gate-res-title { color: #15803d; }
.gate-res.no .gate-res-title { color: #b91c1c; }
.gate-res-msg {
  font-size: 23rpx;
  color: #475569;
  margin-top: 8rpx;
  line-height: 1.6;
}

.pass-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.06);
}
.pass-plate {
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}
.code-text {
  color: #0369a1;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.rule {
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 2;
}

.foot-tip {
  text-align: center;
  font-size: 21rpx;
  color: #b6c0cc;
  padding: 20rpx 0 10rpx;
}
