.hero-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 800;
  color: #fff;
  flex: 0 0 auto;
}

.hero-row {
  display: flex;
  margin-top: 26rpx;
}
.hero-stat {
  flex: 1;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 18rpx;
  padding: 18rpx 22rpx;
  margin-right: 16rpx;
}
.hero-stat:last-child { margin-right: 0; }
.hero-num {
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: -1rpx;
}
.hero-lbl {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 2rpx;
}

.role-cards {
  display: flex;
  margin-bottom: 24rpx;
}
.role-card {
  flex: 1;
  background: #fff;
  border-radius: 22rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  border: 3rpx solid transparent;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.06);
  margin-right: 16rpx;
}
.role-card:last-child { margin-right: 0; }
.role-card.on {
  border-color: #16a34a;
  background: #f0fdf4;
}
.role-ico { font-size: 46rpx; line-height: 1.2; }
.role-name { font-size: 27rpx; font-weight: 700; margin-top: 6rpx; }
.role-desc { font-size: 19rpx; color: #94a3b8; margin-top: 4rpx; line-height: 1.3; }

.entry {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}
.entry:last-child { border-bottom: none; }
.entry-hover { background: #f8fafc; }
.entry-ico {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 22rpx;
  flex: 0 0 auto;
}
.ico-green { background: #dcfce7; }
.ico-blue { background: #e0f2fe; }
.ico-amber { background: #fef3c7; }
.ico-gray { background: #f1f5f9; }
.entry-title { font-size: 29rpx; font-weight: 700; }
.entry-desc { font-size: 22rpx; color: #94a3b8; margin-top: 3rpx; }
.entry-arrow { font-size: 40rpx; color: #cbd5e1; padding-left: 12rpx; }

.apply-tip { border: 1rpx dashed #86efac; background: #f0fdf4; }

.foot-tip {
  text-align: center;
  font-size: 20rpx;
  color: #b6c0cc;
  padding: 20rpx 0 10rpx;
}
