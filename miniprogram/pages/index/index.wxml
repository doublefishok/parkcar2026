<view class="page">

  <!-- 顶部小区信息 -->
  <view class="hero">
    <view class="row-between">
      <view class="flex1">
        <view class="hero-title">{{community.name || '阳光花园'}}</view>
        <view class="hero-sub">{{community.address || '浦东新区阳光路 128 号'}}</view>
        <view class="hero-sub">{{community.households || 468}} 户 · {{community.totalSpots || 386}} 个车位 · 道闸 {{community.barrier || '—'}}</view>
      </view>
      <view class="hero-avatar" bindtap="goProfile">{{avatarText}}</view>
    </view>

    <view class="hero-row">
      <view class="hero-stat">
        <view class="hero-num">{{availableCount}}</view>
        <view class="hero-lbl">近 3 天可租车位</view>
      </view>
      <view class="hero-stat">
        <view class="hero-num">{{liveCount}}</view>
        <view class="hero-lbl">我的进行中订单</view>
      </view>
    </view>
  </view>

  <!-- 身份切换 -->
  <view class="sec">
    <view class="sec-title">选择你的身份</view>
    <view class="sec-hint">切换后进入对应工作台</view>
  </view>
  <view class="role-cards">
    <view class="role-card {{role === 'renter' ? 'on' : ''}}" bindtap="onRole" data-role="renter">
      <view class="role-ico">🚗</view>
      <view class="role-name">租客</view>
      <view class="role-desc">停别人闲置车位</view>
    </view>
    <view class="role-card {{role === 'owner' ? 'on' : ''}}" bindtap="onRole" data-role="owner">
      <view class="role-ico">🅿️</view>
      <view class="role-name">业主</view>
      <view class="role-desc">出租自家空车位</view>
    </view>
    <view class="role-card {{role === 'property' ? 'on' : ''}}" bindtap="onRole" data-role="property">
      <view class="role-ico">🏢</view>
      <view class="role-name">物业</view>
      <view class="role-desc">审核 / 放行 / 分账</view>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="card">
    <view class="entry" hover-class="entry-hover" bindtap="goFind">
      <view class="entry-ico ico-green">🔍</view>
      <view class="flex1">
        <view class="entry-title">我要停车</view>
        <view class="entry-desc">选时段 · 看车位 · 在线支付</view>
      </view>
      <view class="entry-arrow">›</view>
    </view>

    <view class="entry" hover-class="entry-hover" bindtap="goHost">
      <view class="entry-ico ico-blue">🅿️</view>
      <view class="flex1">
        <view class="entry-title">出租我的车位</view>
        <view class="entry-desc">{{ownerSpot ? ('已认证 ' + ownerSpot.spotNo + '，一键发布空闲时段') : '完成车位备案后即可出租'}}</view>
      </view>
      <view class="entry-arrow">›</view>
    </view>

    <view class="entry" hover-class="entry-hover" bindtap="goOrders">
      <view class="entry-ico ico-amber">📋</view>
      <view class="flex1">
        <view class="entry-title">我的订单</view>
        <view class="entry-desc">查看通行码 · 支付 · 超时费用</view>
      </view>
      <view class="entry-arrow">›</view>
    </view>

    <view class="entry" hover-class="entry-hover" bindtap="goProperty">
      <view class="entry-ico ico-gray">🏢</view>
      <view class="flex1">
        <view class="entry-title">物业后台</view>
        <view class="entry-desc">放行名单 · 车位审核 · 经营看板</view>
      </view>
      <view class="entry-arrow">›</view>
    </view>
  </view>

  <!-- 未备案提示 -->
  <view class="card apply-tip" wx:if="{{!ownerSpot}}">
    <view class="row-between">
      <view class="flex1">
        <view class="bold">你还没有备案车位</view>
        <view class="tiny muted mt8">提交车位号与产权信息，物业审核通过后即可出租赚钱</view>
      </view>
      <view class="btn btn-sm btn-primary" bindtap="onApply">去备案</view>
    </view>
  </view>

  <view class="foot-tip">邻里车位 · 社区闲置车位分时共享</view>
</view>
