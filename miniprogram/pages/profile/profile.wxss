.hero-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  flex: 0 0 auto;
}

.role-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}
.role-row:last-child { border-bottom: none; }
.role-row-on .bold { color: #15803d; }
.role-ico {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 20rpx;
}
.role-check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #16a34a;
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rule {
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 2;
}

.foot-tip {
  text-align: center;
  font-size: 20rpx;
  color: #b6c0cc;
  padding: 24rpx 0 10rpx;
}
